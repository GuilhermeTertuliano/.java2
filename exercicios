        for (int i = 0; i < alturas.length; i++) {
            desenharTriangulo(alturas[i]);
            if (i < alturas.length - 1) {
                System.out.println();
            }
        }
    }

    // ---------- Exercício 2 ----------
    public static double calcularImc(double peso, double altura) {
        return peso / (altura * altura);
    }

    public static String classificarImc(double imc) {
        if (imc < 18.5) {
            return "Abaixo do peso";
        } else if (imc < 25) {
            return "Peso normal";
        } else if (imc < 30) {
            return "Sobrepeso";
        } else {
            return "Obesidade";
        }
    }

    public static void exibirRelatorio(double[] pesos, double[] alturas) {
        for (int i = 0; i < pesos.length; i++) {
            double imc = calcularImc(pesos[i], alturas[i]);
            System.out.printf(BR, "Pessoa %d: IMC %.2f - %s%n", i + 1, imc, classificarImc(imc));
        }
    }

