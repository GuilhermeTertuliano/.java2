    // ---------- Exercício 7 ----------
    public static String gerarIniciais(String nomeCompleto) {
        String[] partes = nomeCompleto.trim().split(" ");
        String iniciais = "";
        for (int i = 0; i < partes.length; i++) {
            if (partes[i].length() > 0) {
                iniciais += partes[i].substring(0, 1).toUpperCase() + ".";
            }
        }
        return iniciais;
    }

